{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crimemaps-analytics",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    "COLLECTION_ENABLED": "false",
    "SITE_ORIGIN": "https://ln6666.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "crimemaps-analytics",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{"name": "REQUEST_LIMITER", "namespace_id": "81001", "simple": {"limit": 30, "period": 60}}],
  "triggers": {"crons": ["* * * * *"]}
}
